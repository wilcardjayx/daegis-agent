# OKX OnchainOS API credentials — get them at web3.okx.com/onchain-os/dev-portal
# Copy this file to .env and fill in real values. NEVER commit the real .env.
OKX_API_KEY=your-api-key-here
OKX_SECRET_KEY=your-secret-key-here
OKX_PASSPHRASE=your-passphrase-here

# X Layer RPC (direct endpoint for the live watcher) — verify current URLs at deploy time
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
